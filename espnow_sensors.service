[Unit]
Description=ESPNOW bme sensors listener through esp now bridge  
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dietpi
WorkingDirectory=/home/dietpi/espnow_bridge/espnow_uart_bridge



# === SINON (python système) ===
 ExecStart=/usr/bin/python3 /home/dietpi/espnow_bridge/espnow_uart_bridge/espnow_sensors_listener.py

Restart=always
RestartSec=5

Environment=PYTHONUNBUFFERED=1

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
